# Placeholders only. Copy privately to .env and fill every required value.
LEARNING_PLATFORM_ENVIRONMENT=production
LEARNING_PLATFORM_DATABASE_URL=postgresql+asyncpg://APP_USER:REPLACE_PASSWORD@DB_HOST/APP_DATABASE
LEARNING_PLATFORM_DATABASE_POOL_SIZE=10
LEARNING_PLATFORM_DATABASE_MAX_OVERFLOW=20
LEARNING_PLATFORM_DATABASE_POOL_TIMEOUT_SECONDS=10
LEARNING_PLATFORM_STATEMENT_TIMEOUT_MS=10000
LEARNING_PLATFORM_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LEARNING_PLATFORM_MEDIA_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LEARNING_PLATFORM_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_SECRET_AT_LEAST_32_CHARACTERS
LEARNING_PLATFORM_ACCESS_TOKEN_MINUTES=15
LEARNING_PLATFORM_REFRESH_TOKEN_DAYS=30
LEARNING_PLATFORM_PUBLIC_BASE_URL=https://API_HOST
LEARNING_PLATFORM_ALLOWED_HOSTS=API_HOST
LEARNING_PLATFORM_CORS_ORIGINS=https://STUDENT_HOST,https://CMS_HOST
LEARNING_PLATFORM_REDIS_URL=rediss://:REPLACE_PASSWORD@REDIS_HOST:6379/0
LEARNING_PLATFORM_REDIS_NAMESPACE=learning-platform:production
LEARNING_PLATFORM_MEDIA_CDN_BASE_URL=https://MEDIA_HOST
LEARNING_PLATFORM_MEDIA_TOKEN_MINUTES=10
LEARNING_PLATFORM_PASSWORD_RESET_URL=https://STUDENT_HOST/recover-account
LEARNING_PLATFORM_SMTP_HOST=SMTP_HOST
LEARNING_PLATFORM_SMTP_PORT=587
LEARNING_PLATFORM_SMTP_USERNAME=REPLACE_SMTP_USER
LEARNING_PLATFORM_SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
LEARNING_PLATFORM_SMTP_FROM_ADDRESS=REPLACE_SENDER_ADDRESS
LEARNING_PLATFORM_SMTP_USE_TLS=true
# Optional external error transport. No provider verification is implied.
LEARNING_PLATFORM_SENTRY_DSN=
# Optional commerce: leave the entire provider group absent while disabled.
LEARNING_PLATFORM_APPLE_KEY_ID=
LEARNING_PLATFORM_APPLE_ISSUER_ID=
LEARNING_PLATFORM_APPLE_PRIVATE_KEY=
LEARNING_PLATFORM_APPLE_BUNDLE_ID=
# Omit APPLE_APP_ID entirely when Apple is disabled (an empty integer is invalid).
LEARNING_PLATFORM_APPLE_ENVIRONMENT=production
LEARNING_PLATFORM_APPLE_ROOT_CERTIFICATE_PATHS=
LEARNING_PLATFORM_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
LEARNING_PLATFORM_GOOGLE_PLAY_PACKAGE_NAME=
LEARNING_PLATFORM_GOOGLE_PLAY_PUBSUB_AUDIENCE=
LEARNING_PLATFORM_GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=
LEARNING_PLATFORM_STRIPE_API_KEY=
LEARNING_PLATFORM_STRIPE_WEBHOOK_SECRET=
# Uvicorn trusts only loopback by default. Set exact proxy IPs/CIDRs privately.
# FORWARDED_ALLOW_IPS=REPLACE_WITH_TRUSTED_PROXY_IP

# Backend-only media provider credentials. Never put the secret in Flutter defines.
LEARNING_PLATFORM_CLOUDINARY_CLOUD_NAME=
LEARNING_PLATFORM_CLOUDINARY_API_KEY=
LEARNING_PLATFORM_CLOUDINARY_API_SECRET=
